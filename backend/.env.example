# Application settings
APP_NAME=AI-Based Job Market Skill Trend Analyzer
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./skill_trend.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/skill_trend

# Security
SECRET_KEY=change-me-in-production-super-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NLP
SPACY_MODEL=en_core_web_sm
